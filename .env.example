# Server configuration
PORT=5000
NODE_ENV=development

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration
# Use SQLite for local development: sqlite://./local.db
# Use PostgreSQL for VPS production: postgresql://username:password@localhost:5432/tggamehub
DATABASE_URL=sqlite://./local.db

# Redis Configuration (Optional)
# If left blank, the server will automatically fall back to an in-memory mock leaderboard system
# Redis URL: redis://[:password@]host[:port][/db-number]
REDIS_URL=redis://localhost:6379

# JWT Secret (for session management and secure game session tokens)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:5173

# Secret token for HMAC-SHA256 signature verification between storefront backend and pure-wallet
SHOP_WEBHOOK_SECRET=your_shop_webhook_secret_key_here
