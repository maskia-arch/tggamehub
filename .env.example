# ==============================================================================
# TG GAME HUB — COOLIFY SINGLE-SERVICE CONFIGURATION (.env.example)
# Domain: https://tggamehub.autoacts.link
# ==============================================================================
# Trage diese Umgebungsvariablen direkt in deiner Coolify-Anwendung ein:
# Project -> Application -> "Environment Variables"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & ROUTING
# ------------------------------------------------------------------------------
# Im Live-Betrieb auf 'production' setzen
NODE_ENV=production

# Interner Container-Port (Coolify Traefik leitet tggamehub.autoacts.link auf diesen Port)
PORT=5000

# Öffentliche HTTPS-Domain für Telegram Mini App, Webhook-Verifikation und CORS
FRONTEND_URL=https://tggamehub.autoacts.link

# Optional: Kann leer gelassen werden oder auf tggamehub.autoacts.link gesetzt werden,
# da Backend & Frontend gemeinsam auf derselben Domain laufen
VITE_API_URL=https://tggamehub.autoacts.link

# ------------------------------------------------------------------------------
# 2. SPEICHERSTRUKTUR (PostgreSQL 18 & Redis)
# ------------------------------------------------------------------------------
# PostgreSQL 18 Datenbank-Verbindung
# Bei interner Coolify PostgreSQL-Ressource:
# postgresql://postgres:[DEIN_PASSWORT]@postgres:5432/tggamehub
# (Ersetze [DEIN_PASSWORT] durch dein DB-Passwort aus Coolify)
DATABASE_URL=postgresql://postgres:dein_postgres_passwort_hier@postgres:5432/tggamehub

# SSL für PostgreSQL: 'false' im internen Coolify Docker-Netzwerk
DB_SSL=false

# Redis Verbindung für High-Speed Leaderboards & Cache
# Bei interner Coolify Redis-Ressource:
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT
# ------------------------------------------------------------------------------
# Dein Bot-Token von Telegram @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmnoPQRstuVWXyz123456789

# Telegram Bot Username (ohne @) für die Generierung von Referral-Links
# Beispiel: tggamehub_bot
TELEGRAM_BOT_USERNAME=tggamehub_bot

# ------------------------------------------------------------------------------
# 4. SICHERHEIT & CRYPTO-WEBHOOK
# ------------------------------------------------------------------------------
# Geheimer Schlüssel für Session-Tokens (mindestens 32 Zeichen Zufallswert)
# Generierung im Terminal z.B.: openssl rand -hex 32
JWT_SECRET=super_geheimer_jwt_schluessel_mindestens_32_zeichen_lang

# Geheimer HMAC-Schlüssel für Signaturprüfungen bei Krypto-Zahlungen
SHOP_WEBHOOK_SECRET=dein_sicheres_shop_webhook_secret_123

# Simulation von Testzahlungen im Live-Betrieb deaktivieren ('false')
ENABLE_DEV_SIMULATION=false

# HINWEIS: Das Admin-Dashboard ist online vollständig deaktiviert (gibt 404 zurück)
# und kann ausschließlich lokal über http://localhost:5000/admin bedient werden.


# ------------------------------------------------------------------------------
# 5. OPTIONALE SPIEL-PARAMETER
# ------------------------------------------------------------------------------
# Wiederauflade-Intervall pro Energie-Blitz in Sekunden (3600 = 1 Stunde)
# ENERGY_RECHARGE_INTERVAL=3600

# Maximales Energie-Limit für normale Spieler (Standard: 5)
# MAX_ENERGY=5

# Energie-Bonus für erfolgreiche Weiterempfehlungen (Standard: 5)
# REFERRAL_ENERGY_BONUS=5
